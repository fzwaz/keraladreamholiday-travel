# --- Leads: where form enquiries go ---
# Owner gets every enquiry; checker gets a copy. Administrator gets no mail
# (access comes from Sanity / GitHub / hosting invites, not email).
LEAD_TO_EMAIL=keralaholidays.2959@gmail.com
LEAD_CC_EMAIL=flateath01@gmail.com
LEAD_QUOTE_TO=
LEAD_PACKAGE_TO=

# --- SMTP: how emails are sent (Gmail example) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=16-char App Password (Google Account > Security > 2-Step > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional display name, e.g. "Dreams Kerala <keralaholidays.2959@gmail.com>"
SMTP_FROM=

# --- Zoho CRM: website -> Leads push (server-only vars, never NEXT_PUBLIC_) ---
# From API Console (api-console.zoho.in) > Self Client. The server mints
# short-lived access tokens itself via the refresh token — nothing to renew.
ZOHO_CRM_DC=in
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=tokenk9m
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only Editor token so visitor reviews land in Sanity as drafts.
# Create at sanity.io/manage → project → API → Tokens (Editor role).
SANITY_API_WRITE_TOKEN=

