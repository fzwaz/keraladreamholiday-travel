# --- Leads: where form enquiries go ---
# Change these to choose which inbox gets quote vs package leads.
LEAD_TO_EMAIL=you@example.com
LEAD_QUOTE_TO=
LEAD_PACKAGE_TO=

# --- SMTP: how emails are sent (Gmail example) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=16-char App Password (Google Account > Security > 2-Step > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional display name, e.g. "Dreams Kerala <hello@dreamskeralaholiday.com>"
SMTP_FROM=

# --- Zoho CRM: website -> Leads push (server-only vars, never NEXT_PUBLIC_) ---
# From API Console (api-console.zoho.in) > Self Client. The server mints
# short-lived access tokens itself via the refresh token — nothing to renew.
ZOHO_CRM_DC=in
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=tokenk9m
NEXT_PUBLIC_SANITY_DATASET=production

