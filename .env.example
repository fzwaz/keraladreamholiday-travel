# --- Leads: where form enquiries go ---
# Change these to choose which inbox gets quote vs package leads.
LEAD_TO_EMAIL=you@example.com
LEAD_QUOTE_TO=
LEAD_PACKAGE_TO=

# --- SMTP: how emails are sent (Gmail example) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=16-char App Password (Google Account > Security > 2-Step > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional display name, e.g. "Dreams Kerala <hello@dreamskeralaholiday.com>"
SMTP_FROM=

# --- Zoho CRM (optional, plug in later) ---
# 1. Create account at https://www.zoho.in/crm/ (use .in data centre for India).
# 2. Setup > Developer Space > Self Client > generate access token for scope ZohoCRM.modules.leads.CREATE
# 3. Paste below. Tokens expire (~1h) — for production use refresh-token flow or Zoho Flow webhook.
ZOHO_CRM_DC=in
ZOHO_CRM_ACCESS_TOKEN=
